// File: Main.jack
// Punto de entrada al the Ghost Escape game.
// Compatible con nand2tetris Jack compiler y VM emulator.

class Main {

    /** Starts the game. */
    function void main() {
        var GhostGame game;
        let game = GhostGame.new();
        do game.run();
        do game.dispose();
        return;
    }
}
