// File: Radar.jack
// Manages radar energy. Drawing the radar sweep itself is done by GhostGame,
// since it needs access to ghost positions and the exit.

class Radar {

    field int energy;     // current energy
    field int maxEnergy;  // maximum energy
    field int cost;       // energy cost per use
    field int range;      // detection range (in cells)

    /** Creates a radar with the given starting energy, cost per use, and detection range. */
    constructor Radar new(int startEnergy, int costPerUse, int detectRange) {
        let energy = startEnergy;
        let maxEnergy = startEnergy;
        let cost = costPerUse;
        let range = detectRange;
        return this;
    }

    /** Frees the radar. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method int getEnergy() { return energy; }
    method int getMaxEnergy() { return maxEnergy; }
    method int getRange() { return range; }

    /** Returns true if there is enough energy to perform a sweep. */
    method boolean canScan() {
        return ~(energy < cost);
    }

    /** Consumes energy for one sweep. Returns true if the sweep happened. */
    method boolean scan() {
        if (energy < cost) { return false; }
        let energy = energy - cost;
        return true;
    }
}
