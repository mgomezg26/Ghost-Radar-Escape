// File: Radar.jack
// Maneja la energia del radar. El trazado del barrido del radar lo realiza GhostGame, ya que necesita acceso a las posiciones fantasma y a la salida.

class Radar {

    field int energy;     // current energy
    field int maxEnergy;  // maximum energy
    field int cost;       // energy cost per use
    field int range;      // detection range (in cells)

    /** Crea un radar con la energía inicial dada, costo por uso, y rango de detección */
    constructor Radar new(int startEnergy, int costPerUse, int detectRange) {
        let energy = startEnergy;
        let maxEnergy = startEnergy;
        let cost = costPerUse;
        let range = detectRange;
        return this;
    }

    /** Frees the radar. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method int getEnergy() { return energy; }
    method int getMaxEnergy() { return maxEnergy; }
    method int getRange() { return range; }

    /** Retorna True si hay suficiente energía para hacer el barrido. */
    method boolean canScan() {
        return ~(energy < cost);
    }

    /** Consume energía por un barrido. Retorna True si el barrido se hizo. */
    method boolean scan() {
        if (energy < cost) { return false; }
        let energy = energy - cost;
        return true;
    }
}
