// File: GhostGame.jack
// Main game controller for Ghost Escape.
//
// Rules:
//   - The player navigates an 8x8 grid with the arrow keys.
//   - The map is hidden. The player only sees their own square.
//   - Pressing SPACE activates the radar (consumes energy) and briefly
//     reveals ghosts and the exit that are within range.
//   - 3 ghosts move pseudo-randomly each turn. If one steps onto the
//     player's cell, the player loses.
//   - Reach the exit cell to win.
//   - Press Q at any time to quit.
//
// Screen layout (Hack screen is 512x256):
//   - Play area: 192x192 (8x8 cells of 24x24 px) centered vertically
//     starting at x = 32, y = 32.
//   - HUD: text to the right of the play area showing energy and status.

class GhostGame {

    field Player player;
    field Ghost g1;
    field Ghost g2;
    field Ghost g3;
    field Radar radar;

    field int exitX;       // exit column
    field int exitY;       // exit row

    field int cells;       // grid size (8)
    field int cellPx;      // pixels per cell (24)
    field int originX;     // top-left x of play area in pixels
    field int originY;     // top-left y of play area in pixels

    field int seed;        // global pseudo-random state for placement

    field boolean gameOver;
    field boolean playerWon;

    /** Builds a new game. */
    constructor GhostGame new() {
        let cells = 8;
        let cellPx = 24;
        let originX = 32;
        let originY = 32;
        let seed = 12345;

        // Place exit at top-right corner, player at bottom-left corner.
        let exitX = cells - 1;
        let exitY = 0;

        let player = Player.new(0, cells - 1, cells);

        // Spread ghosts around the middle of the map with different seeds.
        let g1 = Ghost.new(3, 3, cells, 17);
        let g2 = Ghost.new(5, 4, cells, 2731);
        let g3 = Ghost.new(2, 5, cells, 9001);

        // Radar: 10 energy total, 1 per scan, range = 3 cells.
        let radar = Radar.new(10, 1, 3);

        let gameOver = false;
        let playerWon = false;
        return this;
    }

    /** Frees the game and its components. */
    method void dispose() {
        do player.dispose();
        do g1.dispose();
        do g2.dispose();
        do g3.dispose();
        do radar.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Main game loop. */
    method void run() {
        var char key;
        var boolean moved;

        do drawIntro();
        do waitForKey();
        do Screen.clearScreen();
        do drawFrame();
        do drawHUD();
        do drawPlayer();

        while (~gameOver) {
            // Wait for a key to be pressed.
            let key = 0;
            while (key = 0) {
                let key = Keyboard.keyPressed();
            }

            let moved = false;

            if (key = 130) { do player.move(-1, 0); let moved = true; } // left arrow
            if (key = 132) { do player.move(1, 0);  let moved = true; } // right arrow
            if (key = 131) { do player.move(0, -1); let moved = true; } // up arrow
            if (key = 133) { do player.move(0, 1);  let moved = true; } // down arrow
            if (key = 32)  { do doRadar(); }                            // space
            if (key = 81)  { let gameOver = true; let playerWon = false; } // Q
            if (key = 113) { let gameOver = true; let playerWon = false; } // q

            // Wait until the key is released to avoid repeats.
            while (~(Keyboard.keyPressed() = 0)) { }

            if (moved & (~gameOver)) {
                // Player moved this turn -> ghosts step too.
                do g1.step();
                do g2.step();
                do g3.step();

                // Redraw the current view.
                do clearPlay();
                do drawPlayer();
                do drawHUD();

                // Check win/lose conditions.
                if ((player.getX() = exitX) & (player.getY() = exitY)) {
                    let gameOver = true;
                    let playerWon = true;
                }
                if (~gameOver) {
                    if (ghostHitsPlayer()) {
                        let gameOver = true;
                        let playerWon = false;
                    }
                }
            }
        }

        do drawEndScreen();
        do waitForKey();
        return;
    }

    /** True if any ghost is on the player's cell. */
    method boolean ghostHitsPlayer() {
        var int px, py;
        let px = player.getX();
        let py = player.getY();
        if (g1.touches(px, py)) { return true; }
        if (g2.touches(px, py)) { return true; }
        if (g3.touches(px, py)) { return true; }
        return false;
    }

    /** Activates the radar: spends energy and briefly reveals nearby ghosts and the exit. */
    method void doRadar() {
        var int range;
        if (~(radar.canScan())) {
            do drawHUDMessage(0);  // 0 = "No energy!"
            return;
        }
        do radar.scan();
        let range = radar.getRange();

        // Show the sweep for a short time.
        do drawRadarSweep(range);
        do drawHUD();
        do Sys.wait(900);

        // Clear the sweep, keeping only the player visible.
        do clearPlay();
        do drawPlayer();
        do drawHUD();
        return;
    }

    // ---------------------------------------------------------------
    // Drawing helpers
    // ---------------------------------------------------------------

    /** Draws a border around the play area. */
    method void drawFrame() {
        var int x1, y1, x2, y2;
        let x1 = originX - 2;
        let y1 = originY - 2;
        let x2 = originX + (cells * cellPx) + 1;
        let y2 = originY + (cells * cellPx) + 1;

        do Screen.setColor(true);
        do Screen.drawLine(x1, y1, x2, y1);
        do Screen.drawLine(x1, y2, x2, y2);
        do Screen.drawLine(x1, y1, x1, y2);
        do Screen.drawLine(x2, y1, x2, y2);
        return;
    }

    /** Clears the play area (inside the frame). */
    method void clearPlay() {
        var int x1, y1, x2, y2;
        let x1 = originX;
        let y1 = originY;
        let x2 = originX + (cells * cellPx) - 1;
        let y2 = originY + (cells * cellPx) - 1;
        do Screen.setColor(false);
        do Screen.drawRectangle(x1, y1, x2, y2);
        return;
    }

    /** Fills a single cell with the current screen color. */
    method void fillCell(int cx, int cy) {
        var int x1, y1, x2, y2;
        let x1 = originX + (cx * cellPx) + 2;
        let y1 = originY + (cy * cellPx) + 2;
        let x2 = x1 + cellPx - 5;
        let y2 = y1 + cellPx - 5;
        do Screen.drawRectangle(x1, y1, x2, y2);
        return;
    }

    /** Draws a hollow square in a cell. */
    method void outlineCell(int cx, int cy) {
        var int x1, y1, x2, y2;
        let x1 = originX + (cx * cellPx) + 3;
        let y1 = originY + (cy * cellPx) + 3;
        let x2 = x1 + cellPx - 7;
        let y2 = y1 + cellPx - 7;
        do Screen.setColor(true);
        do Screen.drawLine(x1, y1, x2, y1);
        do Screen.drawLine(x1, y2, x2, y2);
        do Screen.drawLine(x1, y1, x1, y2);
        do Screen.drawLine(x2, y1, x2, y2);
        return;
    }

    /** Draws the player as a filled square. */
    method void drawPlayer() {
        do Screen.setColor(true);
        do fillCell(player.getX(), player.getY());
        return;
    }

    /**
     * Draws the radar sweep:
     *   - All cells within `range` (Manhattan distance) get an outline,
     *     so the player can see which area is being scanned.
     *   - Ghosts within range are drawn as filled squares.
     *   - The exit within range is drawn as a hollow square with an X.
     */
    method void drawRadarSweep(int range) {
        var int cx, cy, px, py, dx, dy, d;
        let px = player.getX();
        let py = player.getY();

        // Outline scanned area.
        let cy = 0;
        while (cy < cells) {
            let cx = 0;
            while (cx < cells) {
                let dx = cx - px;
                let dy = cy - py;
                if (dx < 0) { let dx = -dx; }
                if (dy < 0) { let dy = -dy; }
                let d = dx + dy;
                if (~(d > range)) {
                    if (~((cx = px) & (cy = py))) {
                        do outlineCell(cx, cy);
                    }
                }
                let cx = cx + 1;
            }
            let cy = cy + 1;
        }

        // Show ghosts in range.
        do drawGhostIfInRange(g1, px, py, range);
        do drawGhostIfInRange(g2, px, py, range);
        do drawGhostIfInRange(g3, px, py, range);

        // Show exit if in range.
        let dx = exitX - px;
        let dy = exitY - py;
        if (dx < 0) { let dx = -dx; }
        if (dy < 0) { let dy = -dy; }
        let d = dx + dy;
        if (~(d > range)) {
            do drawExitMarker();
        }

        // Player drawn last so they stay visible on top.
        do drawPlayer();
        return;
    }

    /** Helper: fills a ghost's cell if it is within range of (px, py). */
    method void drawGhostIfInRange(Ghost g, int px, int py, int range) {
        var int dx, dy, d;
        let dx = g.getX() - px;
        let dy = g.getY() - py;
        if (dx < 0) { let dx = -dx; }
        if (dy < 0) { let dy = -dy; }
        let d = dx + dy;
        if (~(d > range)) {
            do Screen.setColor(true);
            do fillCell(g.getX(), g.getY());
        }
        return;
    }

    /** Draws an X-style marker on the exit cell. */
    method void drawExitMarker() {
        var int x1, y1, x2, y2;
        let x1 = originX + (exitX * cellPx) + 3;
        let y1 = originY + (exitY * cellPx) + 3;
        let x2 = x1 + cellPx - 7;
        let y2 = y1 + cellPx - 7;
        do Screen.setColor(true);
        do Screen.drawLine(x1, y1, x2, y2);
        do Screen.drawLine(x1, y2, x2, y1);
        // Plus a border around it.
        do Screen.drawLine(x1, y1, x2, y1);
        do Screen.drawLine(x1, y2, x2, y2);
        do Screen.drawLine(x1, y1, x1, y2);
        do Screen.drawLine(x2, y1, x2, y2);
        return;
    }

    // ---------------------------------------------------------------
    // HUD / text
    // ---------------------------------------------------------------

    /** Draws the HUD (energy and instructions) on the right side. */
    method void drawHUD() {
        // Clear the HUD area first.
        do Screen.setColor(false);
        do Screen.drawRectangle(240, 16, 511, 240);

        do Output.moveCursor(1, 32);
        do Output.printString("GHOST ESCAPE");

        do Output.moveCursor(3, 32);
        do Output.printString("Energy: ");
        do Output.printInt(radar.getEnergy());
        do Output.printString("/");
        do Output.printInt(radar.getMaxEnergy());

        do Output.moveCursor(5, 32);
        do Output.printString("Arrows: move");
        do Output.moveCursor(6, 32);
        do Output.printString("Space : radar");
        do Output.moveCursor(7, 32);
        do Output.printString("Q     : quit");

        do Output.moveCursor(10, 32);
        do Output.printString("Find the exit!");
        do Output.moveCursor(11, 32);
        do Output.printString("Avoid the ghosts.");
        return;
    }

    /** Shows a small message in the HUD. code 0 = "No energy!". */
    method void drawHUDMessage(int code) {
        do Output.moveCursor(13, 32);
        if (code = 0) {
            do Output.printString("No energy left!  ");
        }
        return;
    }

    /** Draws the intro screen. */
    method void drawIntro() {
        do Screen.clearScreen();
        do Output.moveCursor(2, 20);
        do Output.printString("=== GHOST ESCAPE ===");
        do Output.moveCursor(5, 10);
        do Output.printString("You are trapped in a dark maze.");
        do Output.moveCursor(6, 10);
        do Output.printString("You cannot see the map.");
        do Output.moveCursor(8, 10);
        do Output.printString("Use the ARROW KEYS to move.");
        do Output.moveCursor(9, 10);
        do Output.printString("Press SPACE to use the radar.");
        do Output.moveCursor(10, 10);
        do Output.printString("The radar drains energy on each use.");
        do Output.moveCursor(12, 10);
        do Output.printString("Three ghosts roam the maze.");
        do Output.moveCursor(13, 10);
        do Output.printString("Avoid them and reach the exit (X).");
        do Output.moveCursor(16, 10);
        do Output.printString("Press any key to start...");
        return;
    }

    /** Draws the end screen depending on whether the player won. */
    method void drawEndScreen() {
        do Screen.clearScreen();
        if (playerWon) {
            do Output.moveCursor(10, 20);
            do Output.printString("*** YOU ESCAPED! ***");
            do Output.moveCursor(12, 20);
            do Output.printString("The ghosts will haunt");
            do Output.moveCursor(13, 20);
            do Output.printString("someone else tonight.");
        } else {
            do Output.moveCursor(10, 20);
            do Output.printString("*** GAME OVER ***");
            do Output.moveCursor(12, 20);
            do Output.printString("A ghost caught you.");
        }
        do Output.moveCursor(16, 20);
        do Output.printString("Press any key to exit.");
        return;
    }

    /** Waits until the user presses and releases any key. */
    method void waitForKey() {
        while (Keyboard.keyPressed() = 0) { }
        while (~(Keyboard.keyPressed() = 0)) { }
        return;
    }
}
